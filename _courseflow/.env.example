PUBLIC_URL=https://your-courseflow.example
DB_PASSWORD=replace-with-a-long-random-password
SMTP_HOST=smtp.your-email-provider.example
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_AUTH=true
SMTP_TLS=true
MAIL_FROM=CourseFlow <alerts@your-verified-domain.example>
POLL_INTERVAL_MS=300000
# Optional: generate once using node scripts/generate-vapid.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-contact@example.com
